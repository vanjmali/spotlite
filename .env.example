# Example .env file for local development

# ----------------------------------------------------------
# To modify any for local testing, create a `.env` file
# in the root directory and copy the variables from here
# ----------------------------------------------------------

#> Application Settings
# Application port used by the main proxy for local development
# This is the port where to access the web applicaiton
APP_HTTP_PORT=3000
APP_HTTPS_PORT=4443

# JWT Secret key used for verifying JWT-signed requests
# Used by multiple service to verify user's access tokens
APP_JWT_VALIDATION_KEY=some-secret-key

#> NATS settings,
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

#> Optional logging settings (used by Go services)
# LOG_DIR should stay as /app/logs in Docker and is mounted to ./logs/<service> via docker-compose.override.yml
LOG_DIR=/app/logs
LOG_ROTATE_MAX_SIZE_MB=20
LOG_ROTATE_MAX_BACKUPS=5
LOG_ROTATE_MAX_AGE_DAYS=14
LOG_ROTATE_COMPRESS=true

#> User Service

# Database credentials
SRV_USER_MONGO_ROOT_USERNAME=root
SRV_USER_MONGO_ROOT_PASSWORD=root
SRV_USER_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_USER_MONGO_DATABASE=user-service
SRV_USER_MONGO_USERNAME=mongo
SRV_USER_MONGO_PASSWORD=123456

# SMTP
SRV_USER_SMTP_HOST=mailhog
SRV_USER_SMTP_PORT=1025
SRV_USER_SMTP_USERNAME=not_important # not checked in mailhog during local development
SRV_USER_SMTP_PASSWORD=not_important # not checked in mailhog during local development
SRV_USER_MAIL_FROM_ADDRESS=mail@spotlite.com

# JWT Secret key used for signing
SRV_USER_JWT_SECRET=super-secret-jwt-token

# JWT Access Token Expiration time in seconds
SRV_USER_JWT_ACCESS_EXPIRATION_SECONDS=3600 # 1 hour

# JWT Refresh Token Expiration time in seconds
SRV_USER_JWT_REFRESH_EXPIRATION_SECONDS=86400 # 1 day

# Refresh token cookie configuration
SRV_USER_REFRESH_COOKIE_NAME=auth
SRV_USER_REFRESH_COOKIE_DOMAIN=
SRV_USER_REFRESH_COOKIE_SECURE=false
SRV_USER_REFRESH_COOKIE_SAMESITE=lax

# URLs for rendering email templates
SRV_USER_VERIFY_URL=https://localhost:4443/register/verify
SRV_USER_PASSWORD_RESET_URL=https://localhost:4443/login/reset

# Login OTP expiration in minutes
SRV_USER_LOGIN_OTP_TTL_MINUTES=5

USER_REDIS_PORT=6380

#> Content Service

# Database credentials

SRV_CONTENT_MONGO_ROOT_USERNAME=root
SRV_CONTENT_MONGO_ROOT_PASSWORD=root
SRV_CONTENT_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_CONTENT_MONGO_DATABASE=content-service
SRV_CONTENT_MONGO_USERNAME=mongo
SRV_CONTENT_MONGO_PASSWORD=123456
SRV_CONTENT_GRPC_PORT=50051
SRV_CONTENT_GRPC_ADDRESS=content-service:50051

# HDFS 

SRV_CONTENT_HDFS_URI=content-hdfs-namenode:8020
SRV_CONTENT_HDFS_AUDIO_BASE=/spotlite/audio
SRV_CONTENT_HDFS_CLUSTER_NAME=spotlite
SRV_CONTENT_HDFS_REPLICATION=1
SRV_CONTENT_HDFS_PERMISSIONS_ENABLED=false
SRV_CONTENT_HDFS_USER=content-service
# allowed values: "", "none", "authentication", "integrity", "privacy"
# local default keeps compatibility with simple single-node dev setups.
SRV_CONTENT_HDFS_DATA_TRANSFER_PROTECTION=none

#> Notification Service

# --- Cassandra Settings ---
CASSANDRA_VERSION=5.0.6
CASSANDRA_CLUSTER_NAME=n1
CASSANDRA_DC=dc1
CASSANDRA_RACK=r1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=notification_service

# --- Resource Limits ---
CASSANDRA_MAX_HEAP=512M
CASSANDRA_NEW_HEAP=100M

# --- Go Service Settings ---
# The hostname must match the container name in docker-compose
CASSANDRA_HOST=notification-cassandra
SRV_CONTENT_MONGO_PASSWORD=123456

# --- Notification service redis ---
NOTIF_REDIS_PORT=6379
NOTIF_REDIS_ADDR=notification-redis:6379

#> Subscription Service

# Database credentials

SRV_SUB_MONGO_ROOT_USERNAME=root
SRV_SUB_MONGO_ROOT_PASSWORD=root
SRV_SUB_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_SUB_MONGO_DATABASE=subscription-service
SRV_SUB_MONGO_USERNAME=mongo
SRV_SUB_MONGO_PASSWORD=123456

#> Rating Service

# Database credentials

SRV_RATING_MONGO_ROOT_USERNAME=root
SRV_RATING_MONGO_ROOT_PASSWORD=root
SRV_RATING_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_RATING_MONGO_DATABASE=rating-service
SRV_RATING_MONGO_USERNAME=mongo
SRV_RATING_MONGO_PASSWORD=123456

#> Recommendation Service

# Database credentials - Neo4j
SRV_REC_NEO4J_URI=neo4j://recommendation-neo4j:7687
SRV_REC_NEO4J_USER=neo4j
SRV_REC_NEO4J_PASSWORD=password
