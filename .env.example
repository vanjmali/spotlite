# Example .env file for local development

# ----------------------------------------------------------
# To modify any for local testing, create a `.env` file
# in the root directory and copy the variables from here
# ----------------------------------------------------------

#> Application Settings
# Application port used by the main proxy for local development
# This is the port where to access the web applicaiton
APP_HTTP_PORT=3000
APP_HTTPS_PORT=4443

# JWT Secret key used for verifying JWT-signed requests
# Used by multiple service to verify user's access tokens
APP_JWT_VALIDATION_KEY=some-secret-key

#> User Service
# Database credentials
SRV_USER_MONGO_ROOT_USERNAME=root
SRV_USER_MONGO_ROOT_PASSWORD=root
SRV_USER_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_USER_MONGO_DATABASE=user-service
SRV_USER_MONGO_USERNAME=mongo
SRV_USER_MONGO_PASSWORD=123456

# SMTP
SRV_USER_SMTP_HOST=mailhog
SRV_USER_SMTP_PORT=1025
SRV_USER_SMTP_USERNAME=not_important # not checked in mailhog during local development
SRV_USER_SMTP_PASSWORD=not_important # not checked in mailhog during local development
SRV_USER_MAIL_FROM_ADDRESS=mail@spotlite.com

# JWT Secret key used for signing
SRV_USER_JWT_SECRET=super-secret-jwt-token

# JWT Access Token Expiration time in seconds
SRV_USER_JWT_ACCESS_EXPIRATION_SECONDS=3600 # 1 hour

# JWT Refresh Token Expiration time in seconds
SRV_USER_JWT_REFRESH_EXPIRATION_SECONDS=86400 # 1 day

# Verification endpoint URL (for email verification link)
SRV_USER_VERIFICATION_ENDPOINT=http://localhost:3000/api/users/verify

# Verification redirect URLs (after successful/failed verification)
SRV_USER_VERIFICATION_SUCCESS_URL=http://localhost:3000/verification-success
SRV_USER_VERIFICATION_FAILURE_URL=http://localhost:3000/verification-failure

# Login OTP expiration in minutes
SRV_USER_LOGIN_OTP_TTL_MINUTES=5

#> Content Service
# Database credentials
SRV_CONTENT_MONGO_ROOT_USERNAME=root
SRV_CONTENT_MONGO_ROOT_PASSWORD=root
SRV_CONTENT_MONGO_ROOT_PASSWORD_FILE="" # alternative to use a file for docker-secrets
SRV_CONTENT_MONGO_DATABASE=content-service
SRV_CONTENT_MONGO_USERNAME=mongo
SRV_CONTENT_MONGO_PASSWORD=123456